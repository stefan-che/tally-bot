# tally-bot — copy to .env and fill in. Read by docker-compose.yml, bot/main.py and the backup scripts.

# ── Telegram ─────────────────────────────────────────────
BOT_TOKEN=
# Telegram user id of the owner: receives the start-up message and has full access. Required.
OWNER_ID=0
# true = only registered users / groups may use the bot (recommended)
USE_GUARD=true
# 1 = print every incoming message (user, chat, text) to stdout. Local debugging only.
DEBUG_PRINT_INPUT=
# Webhook mode (optional). Empty WEBHOOK_HOST = long polling.
WEBHOOK_HOST=
WEBHOOK_PATH=/webhook/telegram
WEBHOOK_SECRET=

# ── Postgres ─────────────────────────────────────────────
POSTGRES_HOST=pg
POSTGRES_PORT=5432
POSTGRES_USER=ledger
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ledger
# Optional full URL for Alembic (overrides the parts above)
# POSTGRES_URL=postgresql+asyncpg://ledger:change-me@pg:5432/ledger

# ── HTTP API + web admin ─────────────────────────────────
API_PORT=8080
# Value of the X-API-KEY header for /api/*
API_TOKEN=
# Comma-separated allowlist for /api/* (empty = any IP)
ALLOWED_IPS=
ADMIN_PATH=/admin
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# ── Automatic balances (cleanroom-watcher) ───────────────
LISTENER_API_URL=http://cleanroom-watcher:8080
LISTENER_API_KEY=
LISTENER_NETWORK=tron
# Interval of the optional wallet-sync compose service, seconds
WALLET_SYNC_INTERVAL=300

# ── Google Drive / Sheets export (optional) ──────────────
# Path (inside the container) to a service-account JSON. Empty = export disabled.
GOOGLE_CREDENTIAL_PATH=
# Address that gets writer access to the created root folder (optional)
GOOGLE_SHARE_EMAIL=
ROOT_FOLDER_NAME="Tally"

# ── Backup scripts ───────────────────────────────────────
PG_CONTAINER_NAME=ledger-pg
# Telegram chat that receives backup files (backup.sh / backup-encrypt.sh). Empty = do not send.
BACKUP_CHAT_ID=
